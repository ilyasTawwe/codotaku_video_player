{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play (Anime4K shader)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/default/codotaku_video_player.exe",
      "args": [
        "--shader",
        "${workspaceFolder}/out/build/default/packs/Anime4K/glsl/Upscale/Anime4K_Upscale_CNN_x2_VL.glsl",
        "${workspaceFolder}/tests/bbb_sunflower_1080p_60fps_normal.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Play (no shader)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/default/codotaku_video_player.exe",
      "args": [
        "${workspaceFolder}/tests/bbb_sunflower_1080p_60fps_normal.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Play (greyscale test)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/default/codotaku_video_player.exe",
      "args": [
        "--shader",
        "${workspaceFolder}/out/build/default/shaders/greyscale.glsl",
        "${workspaceFolder}/tests/bbb_sunflower_1080p_60fps_normal.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}